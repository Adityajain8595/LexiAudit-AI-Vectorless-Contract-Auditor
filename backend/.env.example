# LexiAudit AI - Backend Environment Configuration
PROJECT_NAME="LexiAudit AI"
ENVIRONMENT=production

# Groq LLM Inference API Key (Required)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional: defaults to openai/gpt-oss-120b and openai/gpt-oss-20b
PRIMARY_GROQ_MODEL=openai/gpt-oss-120b
FAST_GROQ_MODEL=openai/gpt-oss-20b

# Supabase Database & Auth (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Upstash Redis (Optional for local, Required for caching)
REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379
# Optional: AES key automatically derives from SUPABASE_SECRET_KEY if omitted
CACHE_SECRET_KEY=
TREE_CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800

# Langfuse Observability & LLMOps (Required for telemetry)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL is also accepted as an alias

# PageIndex API Key (Required for vectorless AST parsing)
PAGEINDEX_API_KEY=your_pageindex_api_key
